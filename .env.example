# copy to .env and fill values
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=3000
HOST=127.0.0.1
TOP_K=3
# Select models available to your OpenRouter account. Existing model defaults are retained in the API.
EMBEDDING_MODEL=
LLM_MODEL=
# Optional: defaults to LLM_MODEL when omitted.
VERIFIER_MODEL=
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Required: generate a private random secret of at least 32 characters.
JWT_SECRET=
NODE_ENV=development
ALLOW_REGISTRATION=true
APP_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Cloud production uses Secure cookies and requires HTTPS.
AUTH_COOKIE_SECURE=false
# Optional paths; defaults shown. Keep these files private and back them up.
# DATABASE_PATH=data/veriqon.sqlite
# SETUP_CODE_PATH=data/setup-code.txt
# DOCUMENT_STORE_PATH=data/documents.json

# PostgreSQL + Redis for deployed environments; omit both for SQLite local development.
DATABASE_URL=
REDIS_URL=
# Use a different namespace for staging; never share production counters with tests.
REDIS_PREFIX=veriqon
DB_MIGRATE_ON_START=true
# Required for the first PostgreSQL owner; generate independently from JWT_SECRET.
SETUP_CODE=
# Cloud startup validates HTTPS origins, required secrets, and database settings.
RAG_TIMEOUT_MS=90000
# Render reverse proxy: set to 1. Leave unset for direct localhost access.
# TRUST_PROXY_HOPS=1
