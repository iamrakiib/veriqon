# Copy to .env for local development and fill values.
# Cloud service ownership/overrides: docs/DEPLOYMENT.md and render.yaml.
# Do not copy development HTTP, integrated mode or automatic migrations into cloud.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=3000
HOST=127.0.0.1
TOP_K=3
# Select models available to your OpenRouter account. Existing model defaults are retained in the API.
EMBEDDING_MODEL=
# Smaller batches reduce request size. Valid range: 1..32.
# Use 1 for endpoints that reject multi-input requests (observed on the current
# Nemotron free endpoint). Increase only after testing your selected endpoint.
EMBEDDING_BATCH_SIZE=8
# Request starts are paced across instances sharing this database/key/model.
# Default: 3000 ms for :free models, 0 otherwise. Range 0..60000.
# This is a configurable precaution, not a known provider quota.
# EMBEDDING_MIN_INTERVAL_MS=3000
# Yield with saved vectors after this many batches (1..1000) or two minutes.
EMBEDDING_JOB_BATCHES_PER_TURN=25
# Optional provider-specific input modes. Set BOTH or neither; changing modes
# requires reindexing existing sources. Never silently mix embedding spaces.
# EMBEDDING_DOCUMENT_INPUT_TYPE=search_document
# EMBEDDING_QUERY_INPUT_TYPE=search_query
LLM_MODEL=
# Optional: defaults to LLM_MODEL when omitted.
VERIFIER_MODEL=
PROVIDER_TIMEOUT_MS=45000
# Total query deadline stays below the hosted proxy limit.
RAG_TIMEOUT_MS=110000
MAX_REPAIR_ATTEMPTS=1
# Disable optional model reasoning for bounded interactive requests; use low to opt in.
RAG_REASONING=off
RETRIEVAL_CANDIDATES=30
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Required: generate a private random secret of at least 32 characters.
JWT_SECRET=
NODE_ENV=development
ALLOW_REGISTRATION=true
APP_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Cloud production uses Secure cookies and requires HTTPS.
AUTH_COOKIE_SECURE=false
# Optional paths; defaults shown. Keep these files private and back them up.
# DATABASE_PATH=data/veriqon.sqlite
# SETUP_CODE_PATH=data/setup-code.txt
# DOCUMENT_STORE_PATH=data/documents.json

# PostgreSQL + Redis for deployed environments; omit both for SQLite local development.
DATABASE_URL=
REDIS_URL=
# Use a different namespace for staging; never share production counters with tests.
REDIS_PREFIX=veriqon
DB_MIGRATE_ON_START=true
# Required for the first PostgreSQL owner; generate independently from JWT_SECRET.
SETUP_CODE=
# Cloud startup validates HTTPS origins, required secrets, and database settings.
# Render reverse proxy: set to 1. Leave unset for direct localhost access.
# TRUST_PROXY_HOPS=1

# Optional independent fact-decomposition model; defaults to VERIFIER_MODEL / LLM_MODEL.
# DECOMPOSER_MODEL=

# Semantic answer cache: similarity proposes a candidate; a strict model gate checks equivalence.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TIMEOUT_MS=8000
# Optional: defaults to VERIFIER_MODEL / LLM_MODEL.
# SEMANTIC_CACHE_MODEL=
ANSWER_CACHE_TTL_MS=300000
ANSWER_CACHE_MAX_ENTRIES=100

# Default single-process local mode. Separate roles require PostgreSQL and BullMQ.
VERIQON_PROCESS_ROLE=integrated
JOB_QUEUE_MODE=sql
# Separate API: VERIQON_PROCESS_ROLE=api, JOB_QUEUE_MODE=bullmq.
# Worker: npm run worker:prod (sets role=worker), JOB_QUEUE_MODE=bullmq.
# Queue Redis must be persistent TCP/TLS with noeviction; separate from disposable counters.
QUEUE_REDIS_URL=
QUEUE_PREFIX=veriqon-jobs
REVALIDATION_ENABLED=true
REVALIDATION_PER_HOUR=10
# Optional worker-only private heartbeat file, one path per supervised process.
# Compose sets /tmp/veriqon-worker-heartbeat.json and overrides the image HTTP healthcheck.
# WORKER_HEARTBEAT_PATH=
